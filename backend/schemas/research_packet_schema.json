{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research_packet.schema.json",
  "title": "Crowlands Research Packet Schema",
  "description": "Schema for Archivist research output - facts and sources only, no persona voice",
  "type": "object",
  "required": [
    "query_understood",
    "research_mode",
    "facts",
    "sources",
    "tradition_context",
    "timeline_anchors"
  ],
  "properties": {
    "query_understood": {
      "type": "string",
      "description": "Archivist's restatement of what the seeker needs"
    },
    "research_mode": {
      "type": "string",
      "enum": [
        "spell_origins",
        "source_explainer",
        "safety_substitutions",
        "cross_traditional_analysis",
        "material_science_context",
        "ritual_anatomy",
        "historical_evolution",
        "geographic_variants",
        "transmission_analysis",
        "contemporary_adaptation"
      ],
      "description": "Which research lens was applied"
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["claim", "claim_type", "confidence", "source_refs"],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 20,
            "description": "The factual claim"
          },
          "claim_type": {
            "type": "string",
            "enum": ["historical", "folklore", "modern_occult", "speculative", "academic"],
            "description": "Type of claim for proper framing"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence level in this claim"
          },
          "source_refs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Source IDs supporting this claim"
          },
          "why_it_works": {
            "type": "string",
            "description": "Framing pattern explaining mechanism"
          },
          "hedging_required": {
            "type": "boolean",
            "description": "If true, Writer must use softening language"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["source_id", "author", "work", "quality_tier"],
        "properties": {
          "source_id": {"type": "string"},
          "author": {"type": "string"},
          "work": {"type": "string"},
          "year": {"type": ["integer", "string", "null"]},
          "quality_tier": {
            "type": "string",
            "enum": [
              "academic_primary",
              "folk_archive",
              "practitioner_primary",
              "modern_scholar_practitioner",
              "community_tradition",
              "speculative_reconstruction",
              "popular_synthesis"
            ]
          },
          "relevance": {"type": "string"},
          "learn_more_url": {"type": "string", "format": "uri"}
        }
      }
    },
    "tradition_context": {
      "type": "object",
      "required": ["primary_tradition", "related_traditions"],
      "properties": {
        "primary_tradition": {"type": "string"},
        "related_traditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "geographic_origin": {"type": "string"},
        "time_period": {"type": "string"},
        "visual_lane": {
          "type": "string",
          "description": "Lane tag from 13-category taxonomy"
        }
      }
    },
    "timeline_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {"type": "string"},
          "year": {"type": "integer"},
          "title": {"type": "string"},
          "relevance": {"type": "string"}
        }
      },
      "description": "Relevant historical events from timeline"
    },
    "material_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material": {"type": "string"},
          "historical_use": {"type": "string"},
          "symbolic_meaning": {"type": "string"},
          "safe_substitution": {"type": "string"}
        }
      },
      "description": "Notes on materials mentioned"
    },
    "safety_flags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Any safety concerns identified"
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string"},
          "why_unverified": {"type": "string"},
          "suggested_framing": {"type": "string"}
        }
      },
      "description": "Claims that need UNVERIFIED tagging"
    }
  },
  "additionalProperties": false
}
